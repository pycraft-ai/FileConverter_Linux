# ============================================
# FileConverter 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# ---------- Flask ----------
# Session 签名密钥（必须修改！用随机字符串）
SECRET_KEY=your-random-secret-key-here

# 调试模式（生产环境设为 0）
FLASK_DEBUG=0

# 服务端口（默认 5000）
PORT=5000

# ---------- CDN 静态资源 ----------
# 静态文件 CDN 地址（当 CDN 不稳定时切换备用地址）
# 国内备选: https://cdn.bootcdn.net
# 国际备选: https://cdn.jsdelivr.net
CDN_BASE_URL=https://cdn.staticfile.org

# ---------- MySQL 数据库 ----------
DB_ACCOUNT=your_db_username
DB_PASSWORD=your_db_password
DB=your_database_name
# MySQL 端口（WSL 内安装默认 3306，WSL 额外实例可能需要 3307）
DB_PORT=3306

# ---------- 邮箱 SMTP（用于发送验证码） ----------
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=your_email@qq.com
# QQ邮箱授权码（非登录密码），在 mail.qq.com → 设置 → 账户 → 开启 SMTP 服务
MAIL_PASSWORD=your-smtp-auth-code

# ---------- 默认管理员账号 ----------
# ⚠️ 生产环境必须设置强密码，不再提供默认值！
# 首次启动时创建管理员使用的密码和邮箱
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
ADMIN_EMAIL=admin@example.com
# 管理员过期时间（默认 2099-12-31 23:59:59）
ADMIN_EXPIRATION=2099-12-31 23:59:59
# 管理员可用次数（默认 9999）
ADMIN_REMAINING_TIMES=9999

# ---------- 安全配置 ----------
# 登录失败限流（同一标识+IP窗口内最多尝试次数，默认10次/300秒）
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
# 验证码发送限流（同一IP每小时最多发送次数，默认5次/3600秒）
VERIFY_CODE_IP_LIMIT=5
VERIFY_CODE_IP_WINDOW=3600
# 密码最小长度（默认8位，要求大小写字母+数字）
PASSWORD_MIN_LENGTH=8
# 可信代理IP（只有来自这些IP才信任 X-Forwarded-For / CF-Connecting-IP 头）
# 多个用逗号分隔，如 127.0.0.1,::1,10.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1,::1
# CSRF 防护开关（默认开启，设为 0 关闭）
CSRF_ENABLED=1
